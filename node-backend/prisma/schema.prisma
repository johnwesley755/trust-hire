generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model early_access_requests {
  id         String    @id @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  email      String    @db.VarChar(255)
  source     String    @db.VarChar(255)
}

model employer_profiles {
  id              String    @id @db.Uuid
  address         String?   @db.VarChar(255)
  business_tier   String?   @db.VarChar(255)
  city            String?   @db.VarChar(255)
  company_name    String?   @db.VarChar(255)
  company_website String?   @db.VarChar(255)
  created_at      DateTime? @db.Timestamp(6)
  industry        String?   @db.VarChar(255)
  is_verified     Boolean?
  latitude        Float?
  location        String?   @db.VarChar(255)
  longitude       Float?
  profile_bio     String?
  updated_at      DateTime? @db.Timestamp(6)
  user_id         String    @unique(map: "uk_jodnbq59inse5oqo0ge2om87l") @db.VarChar(255)

  @@index([user_id], map: "idx_employer_profiles_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model job_applications {
  id           String    @id @db.Uuid
  applied_at   DateTime? @db.Timestamp(6)
  cover_letter String?
  job_id       String    @db.Uuid
  status       String?   @db.VarChar(255)
  worker_id    String    @db.VarChar(255)
  jobs         jobs      @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkqt4m3c9yiioi16kwsyjrl0cpl")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model job_required_skills {
  job_id String  @db.Uuid
  skill  String? @db.VarChar(255)
  jobs   jobs    @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkdhntylyihw6svi8i512l3egoa")

  @@ignore
}

model job_search_index {
  job_id          String    @id @db.Uuid
  address         String?   @db.VarChar(255)
  budget          Float?
  city            String?   @db.VarChar(255)
  description     String?
  indexed_at      DateTime? @db.Timestamp(6)
  category        String?   @db.VarChar(255)
  last_updated_at DateTime? @db.Timestamp(6)
  latitude        Float?
  level           String?   @db.VarChar(255)
  location        String?   @db.VarChar(255)
  longitude       Float?
  required_skills String?   @db.VarChar(255)
  status          String?   @db.VarChar(255)
  title           String    @db.VarChar(255)
  employer_name   String?   @db.VarChar(255)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model jobs {
  id                        String                @id @db.Uuid
  address                   String?               @db.VarChar(255)
  budget                    Decimal?              @db.Decimal(10, 2)
  city                      String?               @db.VarChar(255)
  created_at                DateTime?             @db.Timestamp(6)
  description               String?
  employer_id               String                @db.VarChar(255)
  experience_years_required Int?
  industry                  String?               @db.VarChar(255)
  latitude                  Float?
  location                  String?               @db.VarChar(255)
  longitude                 Float?
  status                    String?               @db.VarChar(255)
  title                     String                @db.VarChar(255)
  updated_at                DateTime?             @db.Timestamp(6)
  employer_name             String?               @db.VarChar(255)
  expires_at                DateTime?             @db.Timestamp(6)
  job_applications          job_applications[]
  job_required_skills       job_required_skills[] @ignore

  @@index([employer_id], map: "idx_jobs_employer_id")
}

model media_assets {
  id         String    @id @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  file_name  String?   @db.VarChar(255)
  file_size  BigInt?
  file_type  String?   @db.VarChar(255)
  owner_id   String    @db.VarChar(255)
  public_id  String    @db.VarChar(255)
  url        String    @db.VarChar(255)
}

model notifications {
  id         String    @id @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  is_read    Boolean?
  message    String
  title      String    @db.VarChar(255)
  type       String?   @db.VarChar(255)
  updated_at DateTime? @db.Timestamp(6)
  user_id    String    @db.VarChar(255)
}

model ratings {
  id          String    @id @db.Uuid
  comment     String?
  created_at  DateTime? @db.Timestamp(6)
  job_id      String    @db.Uuid
  ratee_id    String    @db.VarChar(255)
  reviewer_id String    @db.VarChar(255)
  score       Int
  updated_at  DateTime? @db.Timestamp(6)
}

model skill_test_questions {
  id               String      @id @db.Uuid
  complexity_score Int?
  correct_option   Int
  metadata         Json?
  options          Json
  points           Int?
  question_text    String
  test_id          String      @db.Uuid
  skill_tests      skill_tests @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkdy97ommjrxcwv2oydabjl7y16")
}

model skill_test_results {
  id           String      @id @db.Uuid
  completed_at DateTime?   @db.Timestamp(6)
  passed       Boolean
  score        Int
  worker_id    String      @db.VarChar(255)
  test_id      String      @db.Uuid
  skill_tests  skill_tests @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkcf9mj7uq3aeke9exvmjobpp4g")
}

model skill_tests {
  id                   String                 @id @db.Uuid
  category             String                 @db.VarChar(255)
  created_at           DateTime?              @db.Timestamp(6)
  description          String?
  difficulty           String                 @default("Intermediate") @db.VarChar(255)
  duration_minutes     Int                    @default(30)
  points               Int?
  title                String                 @db.VarChar(255)
  skill_test_questions skill_test_questions[]
  skill_test_results   skill_test_results[]
}

model support_tickets {
  id         String    @id @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  message    String
  priority   String?   @db.VarChar(255)
  status     String?   @db.VarChar(255)
  subject    String    @db.VarChar(255)
  updated_at DateTime? @db.Timestamp(6)
  user_id    String?   @db.VarChar(255)
}

model user_activities {
  id          String    @id @db.Uuid
  created_at  DateTime? @db.Timestamp(6)
  description String    @db.VarChar(255)
  target_id   String?   @db.VarChar(255)
  type        String    @db.VarChar(255)
  user_id     String    @db.VarChar(255)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_metadata {
  id                 String    @id @db.Uuid
  created_at         DateTime? @db.Timestamp(6)
  email              String    @unique(map: "uk_t6c577xeobkhlrxrmvqnlj0u5") @db.VarChar(255)
  email_verified     Boolean?
  first_name         String?   @db.VarChar(255)
  identity_verified  Boolean?
  last_name          String?   @db.VarChar(255)
  onboarded          Boolean?
  password_hash      String?   @db.VarChar(255)
  phone_number       String?   @db.VarChar(255)
  profile_image_url  String?   @db.VarChar(255)
  reset_token        String?   @db.VarChar(255)
  reset_token_expiry DateTime? @db.Timestamp(6)
  role               String    @db.VarChar(255)
  updated_at         DateTime? @db.Timestamp(6)
}

model user_settings {
  user_id             String    @id @db.VarChar(255)
  email_notifications Boolean
  language            String?   @db.VarChar(255)
  marketing_emails    Boolean
  push_notifications  Boolean
  theme               String?   @db.VarChar(255)
  updated_at          DateTime? @db.Timestamp(6)
}

model verification_records {
  id               String    @id @db.Uuid
  confidence_score String?   @db.VarChar(255)
  created_at       DateTime? @db.Timestamp(6)
  doc_image_url    String?   @db.VarChar(255)
  failure_reason   String?   @db.VarChar(255)
  live_image_url   String?   @db.VarChar(255)
  status           String?   @db.VarChar(255)
  updated_at       DateTime? @db.Timestamp(6)
  user_id          String    @db.VarChar(255)
}

model worker_profiles {
  id                String    @id @db.Uuid
  address           String?   @db.VarChar(255)
  bio               String?   @db.VarChar(255)
  city              String?   @db.VarChar(255)
  created_at        DateTime? @db.Timestamp(6)
  experience_score  Float?
  experience_years  Int?
  full_name         String?   @db.VarChar(255)
  hourly_rate       Decimal?  @db.Decimal(10, 2)
  is_available      Boolean?
  latitude          Float?
  level             String?   @db.VarChar(255)
  level_number      Int?
  level_score       Float?
  location          String?   @db.VarChar(255)
  longitude         Float?
  performance_score Float?
  profile_views     BigInt?
  reliability_score Float?
  skill_score       Float?
  skills            String?
  trust_score       Int?
  updated_at        DateTime? @db.Timestamp(6)
  user_id           String    @unique(map: "uk_ljmkjf5tk6w2jt5w4q7rnv3er") @db.VarChar(255)
  abscond_count     Int?
  completed_jobs    Int?
  total_jobs        Int?

  @@index([user_id], map: "idx_worker_profiles_user_id")
}

model worker_search_index {
  user_id           String    @id @db.VarChar(255)
  bio               String?
  city              String?   @db.VarChar(255)
  indexed_at        DateTime? @db.Timestamp(6)
  is_verified       Boolean?
  last_updated_at   DateTime? @db.Timestamp(6)
  latitude          Float?
  level             String?   @db.VarChar(255)
  location          String?   @db.VarChar(255)
  longitude         Float?
  name              String    @db.VarChar(255)
  profile_image_url String?   @db.VarChar(255)
  skills            String?   @db.VarChar(255)
  status            String?   @db.VarChar(255)
  trust_score       Int?
}
